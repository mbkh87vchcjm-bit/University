<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is open source and formatted for Logisim Evolution.
  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar/>

  <!-- Full Adder Subcircuit -->
  <circuit name="FullAdder">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="FullAdder"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(180,180)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(180,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="0" loc="(180,260)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Cin"/>
    </comp>
    <comp lib="1" loc="(280,200)" name="XOR Gate"/>
    <comp lib="1" loc="(380,220)" name="XOR Gate"/>
    <comp lib="1" loc="(280,280)" name="AND Gate"/>
    <comp lib="1" loc="(380,340)" name="AND Gate"/>
    <comp lib="1" loc="(480,310)" name="OR Gate"/>
    <comp lib="0" loc="(420,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Sum"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(520,310)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Cout"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(180,180)" to="(200,180)"/>
    <wire from="(200,180)" to="(200,260)"/>
    <wire from="(200,180)" to="(220,180)"/>
    <wire from="(180,220)" to="(210,220)"/>
    <wire from="(210,220)" to="(210,300)"/>
    <wire from="(210,220)" to="(220,220)"/>
    <wire from="(280,200)" to="(300,200)"/>
    <wire from="(300,200)" to="(300,320)"/>
    <wire from="(300,200)" to="(320,200)"/>
    <wire from="(180,260)" to="(250,260)"/>
    <wire from="(250,260)" to="(250,360)"/>
    <wire from="(250,260)" to="(320,240)"/>
    <wire from="(380,220)" to="(420,220)"/>
    <wire from="(200,260)" to="(230,260)"/>
    <wire from="(210,300)" to="(230,300)"/>
    <wire from="(280,280)" to="(410,280)"/>
    <wire from="(410,280)" to="(410,290)"/>
    <wire from="(410,290)" to="(430,290)"/>
    <wire from="(250,360)" to="(330,360)"/>
    <wire from="(300,320)" to="(330,320)"/>
    <wire from="(380,340)" to="(410,340)"/>
    <wire from="(410,340)" to="(410,330)"/>
    <wire from="(410,330)" to="(430,330)"/>
    <wire from="(480,310)" to="(520,310)"/>
  </circuit>

  <!-- AdderSubtractor4Bit Subcircuit -->
  <circuit name="AdderSubtractor4Bit">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="AdderSubtractor4Bit"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(150,150)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(150,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(150,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Sub"/>
    </comp>
    <comp lib="3" loc="(300,180)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(230,210)" name="XOR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(170,230)" name="Bit Extender">
      <a name="in_width" val="1"/>
      <a name="out_width" val="4"/>
    </comp>
    <comp lib="0" loc="(350,180)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Result"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(350,230)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Cout"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(150,150)" to="(260,150)"/>
    <wire from="(260,150)" to="(260,170)"/>
    <wire from="(150,200)" to="(170,200)"/>
    <wire from="(170,200)" to="(170,190)"/>
    <wire from="(170,190)" to="(170,190)"/>
    <wire from="(150,200)" to="(170,200)"/>
    <wire from="(150,250)" to="(160,250)"/>
    <wire from="(160,250)" to="(160,230)"/>
    <wire from="(160,230)" to="(170,230)"/>
    <wire from="(160,250)" to="(280,250)"/>
    <wire from="(280,200)" to="(280,250)"/>
    <wire from="(150,200)" to="(170,200)"/>
    <wire from="(170,200)" to="(170,190)"/>
    <wire from="(170,190)" to="(170,190)"/>
    <wire from="(170,190)" to="(170,200)"/>
    <wire from="(170,200)" to="(170,200)"/>
    <wire from="(230,210)" to="(250,210)"/>
    <wire from="(250,190)" to="(250,210)"/>
    <wire from="(250,190)" to="(260,190)"/>
    <wire from="(300,180)" to="(350,180)"/>
    <wire from="(300,190)" to="(320,190)"/>
    <wire from="(320,190)" to="(320,230)"/>
    <wire from="(320,230)" to="(350,230)"/>
  </circuit>

  <!-- Decoder3to8 Subcircuit -->
  <circuit name="Decoder3to8">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Decoder3to8"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(150,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Opcode"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="2" loc="(220,200)" name="Decoder">
      <a name="select" val="3"/>
    </comp>
    <comp lib="0" loc="(300,120)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D0_AND"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,150)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D1_OR"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,180)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D2_XOR"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,210)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D3_ADD"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,240)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D4_SUB"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,270)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D5_UNUSED"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,300)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D6_UNUSED"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(300,330)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="D7_UNUSED"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(150,200)" to="(220,200)"/>
    <wire from="(240,120)" to="(300,120)"/>
    <wire from="(240,130)" to="(260,130)"/>
    <wire from="(260,130)" to="(260,150)"/>
    <wire from="(260,150)" to="(300,150)"/>
    <wire from="(240,140)" to="(270,140)"/>
    <wire from="(270,140)" to="(270,180)"/>
    <wire from="(270,180)" to="(300,180)"/>
    <wire from="(240,150)" to="(280,150)"/>
    <wire from="(280,150)" to="(280,210)"/>
    <wire from="(280,210)" to="(300,210)"/>
    <wire from="(240,160)" to="(280,160)"/>
    <wire from="(280,160)" to="(280,240)"/>
    <wire from="(280,240)" to="(300,240)"/>
    <wire from="(240,170)" to="(270,170)"/>
    <wire from="(270,170)" to="(270,270)"/>
    <wire from="(270,270)" to="(300,270)"/>
    <wire from="(240,180)" to="(260,180)"/>
    <wire from="(260,180)" to="(260,300)"/>
    <wire from="(260,300)" to="(300,300)"/>
    <wire from="(240,190)" to="(250,190)"/>
    <wire from="(250,190)" to="(250,330)"/>
    <wire from="(250,330)" to="(300,330)"/>
  </circuit>

  <!-- ControlUnit Subcircuit -->
  <circuit name="ControlUnit">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="ControlUnit"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(150,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Opcode"/>
      <a name="width" val="3"/>
    </comp>
    <comp loc="(380,200)" name="Decoder3to8"/>
    <comp lib="1" loc="(480,280)" name="OR Gate">
      <a name="inputs" val="5"/>
    </comp>
    <comp lib="0" loc="(520,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="ALU_Sel"/>
      <a name="output" val="true"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="0" loc="(520,280)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="RegWrite"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(520,340)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="SubSignal"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(150,200)" to="(160,200)"/>
    <wire from="(150,200)" to="(520,200)"/>
    <wire from="(380,200)" to="(400,200)"/>
    <wire from="(380,220)" to="(400,220)"/>
    <wire from="(380,240)" to="(400,240)"/>
    <wire from="(380,260)" to="(400,260)"/>
    <wire from="(380,280)" to="(400,280)"/>

    <wire from="(400,200)" to="(430,200)"/>
    <wire from="(430,200)" to="(430,260)"/>
    <wire from="(400,220)" to="(420,220)"/>
    <wire from="(420,220)" to="(420,270)"/>
    <wire from="(400,240)" to="(430,240)"/>
    <wire from="(430,240)" to="(430,280)"/>
    <wire from="(400,260)" to="(420,260)"/>
    <wire from="(420,260)" to="(420,290)"/>
    <wire from="(400,280)" to="(410,280)"/>
    <wire from="(410,280)" to="(410,300)"/>
    <wire from="(410,280)" to="(410,340)"/>
    <wire from="(410,340)" to="(520,340)"/>

    <wire from="(430,260)" to="(430,260)"/>
    <wire from="(430,260)" to="(430,260)"/>
    <wire from="(480,280)" to="(520,280)"/>
  </circuit>

  <!-- ALU4Bit Subcircuit -->
  <circuit name="ALU4Bit">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="ALU4Bit"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(150,150)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(150,210)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(150,380)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="ALU_Sel"/>
      <a name="width" val="3"/>
    </comp>

    <!-- Gates for AND, OR, XOR -->
    <comp lib="1" loc="(260,130)" name="AND Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(260,190)" name="OR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(260,250)" name="XOR Gate">
      <a name="width" val="4"/>
    </comp>

    <!-- AdderSubtractor for ADD/SUB -->
    <comp loc="(320,310)" name="AdderSubtractor4Bit"/>

    <!-- Multiplexer to select output -->
    <comp lib="2" loc="(420,220)" name="Multiplexer">
      <a name="select" val="3"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Zero Flag check -->
    <comp lib="1" loc="(520,300)" name="NOR Gate">
      <a name="inputs" val="4"/>
    </comp>
    <comp lib="0" loc="(480,300)" name="Splitter">
      <a name="fanout" val="4"/>
      <a name="incoming" val="4"/>
    </comp>

    <comp lib="0" loc="(550,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Result"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(550,300)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Zero"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(550,350)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Cout"/>
      <a name="output" val="true"/>
    </comp>

    <wire from="(150,150)" to="(180,150)"/>
    <wire from="(180,150)" to="(180,110)"/>
    <wire from="(180,110)" to="(210,110)"/>
    <wire from="(180,150)" to="(180,170)"/>
    <wire from="(180,170)" to="(210,170)"/>
    <wire from="(180,170)" to="(180,230)"/>
    <wire from="(180,230)" to="(200,230)"/>
    <wire from="(180,230)" to="(180,290)"/>
    <wire from="(180,290)" to="(190,290)"/>

    <wire from="(150,210)" to="(170,210)"/>
    <wire from="(170,210)" to="(170,150)"/>
    <wire from="(170,150)" to="(210,150)"/>
    <wire from="(170,210)" to="(210,210)"/>
    <wire from="(170,210)" to="(170,270)"/>
    <wire from="(170,270)" to="(200,270)"/>
    <wire from="(170,270)" to="(170,310)"/>
    <wire from="(170,310)" to="(190,310)"/>

    <!-- ALU_Sel decoded for AdderSubtractor Sub signal -->
    <wire from="(150,380)" to="(400,380)"/>
    <wire from="(400,260)" to="(400,380)"/>

    <!-- Connect AND to Mux 0 -->
    <wire from="(260,130)" to="(380,130)"/>
    <wire from="(380,180)" to="(380,130)"/>
    <wire from="(380,180)" to="(390,180)"/>

    <!-- Connect OR to Mux 1 -->
    <wire from="(260,190)" to="(390,190)"/>

    <!-- Connect XOR to Mux 2 -->
    <wire from="(260,250)" to="(370,250)"/>
    <wire from="(370,200)" to="(370,250)"/>
    <wire from="(370,200)" to="(390,200)"/>

    <!-- Connect AdderSubtractor Result to Mux 3 and Mux 4 -->
    <wire from="(320,310)" to="(350,310)"/>
    <wire from="(350,210)" to="(350,310)"/>
    <wire from="(350,210)" to="(390,210)"/>
    <wire from="(350,220)" to="(350,310)"/>
    <wire from="(350,220)" to="(390,220)"/>

    <!-- Mux Output -->
    <wire from="(420,220)" to="(460,220)"/>
    <wire from="(460,220)" to="(550,220)"/>
    <wire from="(460,220)" to="(460,300)"/>
    <wire from="(460,300)" to="(480,300)"/>

    <!-- Zero flag wires -->
    <wire from="(500,260)" to="(520,260)"/>

    <!-- Cout wire -->
    <wire from="(320,330)" to="(550,350)"/>
  </circuit>

  <!-- Main System Circuit -->
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="simulationFrequency" val="1.0"/>

    <!-- Inputs -->
    <comp lib="0" loc="(120,160)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Input_A"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(120,260)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Input_B"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(120,380)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Opcode"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="0" loc="(120,440)" name="Clock">
      <a name="label" val="Clock"/>
    </comp>
    <comp lib="0" loc="(120,480)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Load_A"/>
    </comp>
    <comp lib="0" loc="(120,520)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Load_B"/>
    </comp>

    <!-- Register A -->
    <comp lib="4" loc="(260,130)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Register B -->
    <comp lib="4" loc="(260,230)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Control Unit -->
    <comp loc="(280,380)" name="ControlUnit"/>

    <!-- ALU -->
    <comp loc="(480,200)" name="ALU4Bit"/>

    <!-- Result Register -->
    <comp lib="4" loc="(580,200)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Outputs -->
    <comp lib="0" loc="(700,230)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Final_Output"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(700,300)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Zero_Flag"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(700,340)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Carry_Flag"/>
      <a name="output" val="true"/>
    </comp>

    <!-- Wire Connections -->
    <wire from="(120,160)" to="(260,160)"/>
    <wire from="(120,260)" to="(260,260)"/>
    <wire from="(120,380)" to="(160,380)"/>

    <!-- Clock wiring -->
    <wire from="(120,440)" to="(220,440)"/>
    <wire from="(220,200)" to="(220,300)"/>
    <wire from="(220,200)" to="(260,200)"/>
    <wire from="(220,300)" to="(220,440)"/>
    <wire from="(220,300)" to="(260,300)"/>
    <wire from="(220,440)" to="(540,440)"/>
    <wire from="(540,270)" to="(540,440)"/>
    <wire from="(540,270)" to="(580,270)"/>

    <!-- Load controls -->
    <wire from="(120,480)" to="(240,480)"/>
    <wire from="(240,180)" to="(240,480)"/>
    <wire from="(240,180)" to="(260,180)"/>

    <wire from="(120,520)" to="(250,520)"/>
    <wire from="(250,280)" to="(250,520)"/>
    <wire from="(250,280)" to="(260,280)"/>

    <!-- Register outputs to ALU inputs -->
    <wire from="(320,160)" to="(380,160)"/>
    <wire from="(380,160)" to="(380,200)"/>
    <wire from="(380,200)" to="(390,200)"/>

    <wire from="(320,260)" to="(380,260)"/>
    <wire from="(380,220)" to="(380,260)"/>
    <wire from="(380,220)" to="(390,220)"/>

    <!-- Control Unit outputs to ALU & Result Register Write -->
    <wire from="(280,380)" to="(350,380)"/>
    <wire from="(350,240)" to="(350,380)"/>
    <wire from="(350,240)" to="(390,240)"/>

    <wire from="(280,400)" to="(520,400)"/>
    <wire from="(520,250)" to="(520,400)"/>
    <wire from="(520,250)" to="(580,250)"/>

    <!-- ALU output to Result Register input -->
    <wire from="(480,200)" to="(580,230)"/>
    <wire from="(480,220)" to="(700,300)"/>
    <wire from="(480,240)" to="(700,340)"/>

    <!-- Result Register output to Final Output -->
    <wire from="(640,230)" to="(700,230)"/>

  </circuit>
</project>
